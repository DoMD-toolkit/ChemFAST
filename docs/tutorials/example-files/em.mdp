integrator = steep
nsteps            = 50000
emtol         = 1000  ;
emstep            = 0.001 ; 100ns
nstcomm         = 100
comm-grps  = system
energygrps =
;
nstxout = 100
nstlog  = 1000
nstenergy = 1000
nstxout-compressed = 1000
compressed-x-grps  = system
;
annealing = no
annealing_npoints = 4
annealing_time = 0 1000 90000 100000
annealing_temp = 300 1000 500 463
;
pbc = xyz
cutoff-scheme = Verlet
coulombtype   = PME
rcoulomb      = 1.2
fourierspacing= 0.12
pme-order     = 4
vdwtype       = cut-off
rvdw          = 1.2
DispCorr      = EnerPres

constraints = none;0
